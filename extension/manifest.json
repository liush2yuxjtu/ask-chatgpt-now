{
  "manifest_version": 3,
  "name": "Ask ChatGPT Now",
  "version": "1.0.0",
  "description": "Click for a ChatGPT window, or type ask + Tab + your prompt in the address bar. No API key needed.",
  "minimum_chrome_version": "109",
  "homepage_url": "https://github.com/liush2yuxjtu/ask-chatgpt-now",
  "action": {
    "default_title": "Open ChatGPT in a window (Alt+Shift+G)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "omnibox": { "keyword": "ask" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Open ChatGPT in a window"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
