{
  "manifest_version": 3,
  "name": "Ask ChatGPT Now",
  "version": "2.0.0",
  "description": "Type a question in Chrome's address bar and press Enter. ChatGPT opens in the same tab and submits it as a normal chat.",
  "minimum_chrome_version": "109",
  "homepage_url": "https://github.com/liush2yuxjtu/ask-chatgpt-now",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "omnibox": { "keyword": "ask" },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "ChatGPT",
      "keyword": "chatgpt.com",
      "search_url": "https://chatgpt.com/?q={searchTerms}",
      "favicon_url": "https://chatgpt.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
