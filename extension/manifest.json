{
  "manifest_version": 3,
  "name": "Ask ChatGPT Now",
  "version": "3.0.0",
  "description": "Send address-bar prompts in the same tab. The extension fills ChatGPT and clicks Send once, instead of relying on URL auto-send.",
  "minimum_chrome_version": "109",
  "homepage_url": "https://github.com/liush2yuxjtu/ask-chatgpt-now",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "permissions": ["webNavigation"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["auto-submit.js"],
    "run_at": "document_start"
  }],
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "ChatGPT",
      "keyword": "chatgpt.com",
      "search_url": "https://chatgpt.com/?ask_chatgpt_now=1#ask-chatgpt-now={searchTerms}",
      "favicon_url": "https://chatgpt.com/favicon.ico",
      "encoding": "UTF-8",
      "is_default": true
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
